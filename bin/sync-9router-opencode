#!/usr/bin/env node
"use strict";

/*
 * sync-9router-opencode
 *
 * Generic 9router -> OpenCode config sync.
 *
 * Design rules:
 *  - No provider ids, prefixes, names, model ids or model allowlists are
 *    hardcoded. Everything comes from the running 9router instance.
 *  - The live router catalog (/v1/models) is the source of truth.
 *  - /api/provider-nodes supplies custom provider names and node id -> prefix.
 *  - /api/models supplies human model names, capabilities and limits.
 *  - /api/models/availability is optional and only used to report/downrank
 *    permanently unavailable entries.
 *  - Existing OpenCode config is only used to preserve provider ids/names and
 *    non-managed settings, never to decide which models exist.
 */

const fs = require("fs");
const path = require("path");
const os = require("os");
const { execFileSync } = require("child_process");

const VERSION = "4.1.0";
const HOME = process.env.HOME || os.homedir();
const DEFAULT_PORT = process.env.ROUTER_PORT || "20128";
const STATE_BASENAME = ".9router-sync-state.json";
const LIMITS_BASENAME = ".9router-sync-limits.json";

const DEFAULTS = {
  package: process.env.OPENCODE_COMPATIBLE_PACKAGE || "@opencode/ai/providers/openai-compatible",
  schema: process.env.OPENCODE_SCHEMA || "https://opencode.ai/config.json",
  modelsPath: process.env.ROUTER_MODELS_PATH || "/v1/models",
  apiModelsPath: process.env.ROUTER_API_MODELS_PATH || "/api/models",
  providerNodesPath: process.env.ROUTER_PROVIDER_NODES_PATH || "/api/provider-nodes",
  availabilityPath: process.env.ROUTER_AVAILABILITY_PATH || "/api/models/availability",
  dbPath: process.env.ROUTER_DB_PATH || path.join(HOME, ".9router", "db", "data.sqlite"),
  dbKeyQuery:
    process.env.ROUTER_DB_KEY_QUERY ||
    "SELECT key FROM apiKeys WHERE isActive = 1 ORDER BY createdAt ASC LIMIT 1",
  dbNodesQuery:
    process.env.ROUTER_DB_NODES_QUERY ||
    "SELECT provider, data FROM providerConnections WHERE isActive = 1",
  upstreamTimeout: Number(process.env.ROUTER_UPSTREAM_TIMEOUT || 20),
};

const OPTION_SPEC = {
  help: { type: "bool", short: "h" },
  version: { type: "bool", short: "v" },
  dryRun: { type: "bool", short: "n", long: "dry-run" },
  config: { type: "string" },
  router: { type: "string" },
  apiBase: { type: "string", long: "api-base" },
  apiKey: { type: "string", long: "api-key" },
  db: { type: "string" },
  dbKeyQuery: { type: "string", long: "db-key-query" },
  dbNodesQuery: { type: "string", long: "db-nodes-query" },
  package: { type: "string" },
  schema: { type: "string" },
  modelsPath: { type: "string", long: "models-path" },
  apiModelsPath: { type: "string", long: "api-models-path" },
  providerNodesPath: { type: "string", long: "provider-nodes-path" },
  availabilityPath: { type: "string", long: "availability-path" },
  provider: { type: "list" },
  exclude: { type: "list" },
  model: { type: "list" },
  excludeModel: { type: "list", long: "exclude-model" },
  limit: { type: "number" },
  keepMissing: { type: "bool", long: "keep-missing" },
  pruneMissing: { type: "bool", long: "prune-missing" },
  replace: { type: "bool" },
  backup: { type: "bool" },
  noBackup: { type: "bool", long: "no-backup" },
  reload: { type: "bool" },
  noReload: { type: "bool", long: "no-reload" },
  minModels: { type: "number", long: "min-models" },
  allowEmpty: { type: "bool", long: "allow-empty" },
  json: { type: "bool" },
  quiet: { type: "bool" },
  verbose: { type: "bool" },
  showUnavailable: { type: "bool", long: "show-unavailable" },
  showContext: { type: "bool", long: "show-context" },
  noUpstreamMetadata: { type: "bool", long: "no-upstream-metadata" },
  upstreamTimeout: { type: "number", long: "upstream-timeout" },
};

let opts = {};
let apiKey = "";
let baseURL = "";
let apiBase = "";
let dbPath = DEFAULTS.dbPath;
let configPath = "";
let statePath = "";
let limitOverrides = {};

const clone = (value) => (value == null ? value : JSON.parse(JSON.stringify(value)));

